# Maintainer: Gomasy <nyan@gomasy.jp>
# Contributor: James Bowling <kf5u AT pm DOT me>
pkgname=wsjtx-improved
_pkgname=ws
pkgver=3.2.1
pkgrel=260926
_build=260926
pkgdesc="Software for Amateur Radio Weak-Signal Communication (JT9 and JT65) - WS Suite (formerly WSJT-X Improved) by DG2YCB"
arch=('x86_64' 'aarch64')
url="https://sourceforge.net/projects/wsjt-x-improved/"
license=('GPL3')
depends=(
	'boost-libs'
	'fftw'
	'hamlib>=4.5'
	'libusb'
	'portaudio'
	'qt5-base'
	'qt5-multimedia'
	'qt5-serialport'
	'qt5-tools'
	'qt5-websockets'
	'readline'
)
makedepends=(
	'cmake'
	'asciidoc'
	'asciidoctor'
	'boost'
	'gcc-fortran'
	'texinfo'
)
install=wsjtx-improved.install
provides=('wsjtx')
conflicts=('wsjtx')
source=("https://downloads.sourceforge.net/project/wsjt-x-improved/WS_v$pkgver/Source%20code/$_pkgname-${pkgver}_${_build}.tgz")
md5sums=('2263d44fcfbcf33e23808f5a1d6edabb')
sha1sums=('1c32ce6009b000290b045d69663d4299f97dad50')
options=(!lto)
prepare() {
	tar xzf ${_pkgname}-${pkgver}_${_build}.tgz
	mkdir -p "$srcdir"/$_pkgname-$pkgver/ws-prefix/build
	cd "$srcdir"/$_pkgname-$pkgver/ws-prefix
	tar xzf "$srcdir"/$_pkgname-$pkgver/src/ws.tgz
}
build() {
	local _fortran_flags _flag
	for _flag in ${CFLAGS}; do
		case "${_flag}" in
			-Wformat*|-Werror=format-security) ;;
			*) _fortran_flags+="${_flag} " ;;
		esac
	done

	cd "$srcdir"/$_pkgname-$pkgver/ws-prefix/build
	cmake \
		-Wno-dev \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_C_FLAGS="${CFLAGS} -Wno-format-security -Wno-unused-parameter" \
		-DCMAKE_Fortran_FLAGS="${_fortran_flags}" \
		../ws
	make || return 1
}
package() {
	cd "$srcdir"/$_pkgname-$pkgver/ws-prefix/build
	make DESTDIR=$pkgdir install
	install -Dm644 "$srcdir"/$_pkgname-$pkgver/ws-prefix/ws/sounds/{ContinentOnBand,Continent,CQ,CQZoneOnBand,CQZone,DXcall,DXCCOnBand,DXCC,GridOnBand,Grid,ITUZoneOnBand,ITUZone,MyCall,_Zone}.wav -t "$pkgdir"/opt/wsjtx/sounds
	rm -rf "$pkgdir/home"
}
