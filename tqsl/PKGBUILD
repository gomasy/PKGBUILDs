# Maintainer: Gomasy <nyan@gomasy.jp>
# Contributor: Filipe Laíns <lains@riseup.net>

pkgname=tqsl
pkgver=2.8.7
pkgrel=1
pkgdesc='ARRL LoTW Trusted QSL (TQSL) software'
url='https://www.arrl.org/tqsl-download'
arch=('x86_64' 'aarch64')
license=('custom')
depends=('openssl' 'sqlite' 'expat' 'zlib' 'curl' 'wxwidgets-gtk3')
makedepends=('cmake')
source=("https://www.arrl.org/tqsl/tqsl-$pkgver.tar.gz")
sha512sums=('ddd2e2dc6bc3e53eff670fd727f7a230ae2116993582080f000bca00ff5ac7de5677402ed971d24d84a9146e768fe2c0fffeae1bab96c73480c30232d88d11f5')

build() {
  cd $pkgname-$pkgver

  cmake -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_ALL_EXTRAPROGS=true

  cmake --build build
}

package() {
  cd $pkgname-$pkgver

  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 LICENSE.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
